# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Supabase — obrigatório
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Stripe — chave pública (pk_live_... em produção)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

