# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Supabase — obrigatório
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Stripe — chave pública (pk_live_... em produção)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Loja: pagamento online pelo Mercado Pago (deixe off até configurar os secrets MP_* abaixo)
VITE_ONLINE_PAYMENT=off

# ── Supabase Edge Functions (nunca commitar — configurar via CLI) ─────────────
# supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
# supabase secrets set STRIPE_PRICE_ID_BASIC=price_...
# supabase secrets set STRIPE_PRICE_ID_PRO=price_...
# supabase secrets set STRIPE_PRICE_ID_PREMIUM=price_...
# supabase secrets set RESEND_API_KEY=re_...
# supabase secrets set EMAIL_FROM="BarberOS <noreply@barberos.io>"
#
# Loja — pagamento online (Mercado Pago, modelo marketplace)
# supabase secrets set MP_CLIENT_ID=...            # app no painel de devs do Mercado Pago
# supabase secrets set MP_CLIENT_SECRET=...
# supabase secrets set MP_TOKEN_KEY="$(openssl rand -base64 32)"   # cifra os tokens das barbearias
# supabase secrets set MP_WEBHOOK_SECRET=...       # opcional: assinatura secreta dos webhooks
# supabase secrets set MP_PLATFORM_FEE_PCT=1.5     # opcional: taxa da plataforma em %
# Redirect URL do app MP: https://<ref>.supabase.co/functions/v1/mp-oauth-callback
